---
import PageLayout from '../../layouts/PageLayout.astro';
import ActionLink from '../ui/ActionLink.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import BrowserFrame from '../ui/BrowserFrame.astro';
import type { Project } from '../../data/projects';
import { projectImage, projects } from '../../data/projects';
import { absolute, projectPath, routes, ui } from '../../data/site';
import { skillIcon } from '../../data/skills';
import { imageSize } from '../../data/imageSize';
import type { Lang } from '../../data/translations';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const es = lang === 'es';
const t = {
  projects: ui[lang].nav.projects,
  back: es ? 'Todos los proyectos' : 'All projects',
  about: es ? 'El proyecto' : 'The project',
  built: es ? 'Lo que construí' : 'What I built',
  client: es ? 'Cliente' : 'Client',
  role: es ? 'Rol' : 'Role',
  location: es ? 'Ubicación' : 'Location',
  year: es ? 'Año' : 'Year',
  stack: es ? 'Tecnologías' : 'Tech stack',
  demo: es ? 'Ver sitio' : 'Visit site',
  code: es ? 'Código' : 'Code',
  mockup: 'Mockup',
  screens: es ? 'Pantallas' : 'Screens',
  next: es ? 'Siguiente proyecto' : 'Next project',
  prev: es ? 'Proyecto anterior' : 'Previous project',
};

const idx = projects.findIndex(p => p.slug === project.slug);
const prev = projects[(idx - 1 + projects.length) % projects.length];
const next = projects[(idx + 1) % projects.length];
const fullSize = project.fullPage ? await imageSize(projectImage(project, 'full.webp')) : {};
const gallery = Array.from({ length: project.gallery }, (_, i) => projectImage(project, `${i + 1}.webp`));
const shotAlt = (n: number) => (es ? `${project.name}: pantalla ${n}` : `${project.name}: screen ${n}`);

const title = `${project.name}: ${project.category[lang]} | Anderson Rueda`;
const description = `${project.summary[lang]} ${project.stack.slice(0, 4).join(', ')}.`;

const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.name,
  headline: `${project.name} - ${project.category[lang]}`,
  description: project.description[lang],
  url: absolute(projectPath(project.slug, lang)),
  image: absolute(projectImage(project, 'cover.webp')),
  dateCreated: project.year.slice(0, 4),
  inLanguage: lang,
  keywords: project.stack.join(', '),
  creator: { '@id': `${absolute('/')}#person` },
  ...(project.demoUrl ? { sameAs: project.demoUrl } : {}),
};
---

<PageLayout
  lang={lang}
  title={title}
  description={description}
  paths={{ es: projectPath(project.slug, 'es'), en: projectPath(project.slug, 'en') }}
  crumbs={[
    { label: t.projects, href: routes.projects[lang] },
    { label: project.name, href: projectPath(project.slug, lang) },
  ]}
  ogImage={absolute(projectImage(project, 'cover.webp'))}
  ogType="article"
>
  <script type="application/ld+json" slot="schema" set:html={JSON.stringify(projectSchema)} />

  <article class="case" style={`--brand: ${project.color}`}>
    <div class="case-info">
      <div class="case-info-inner">
        <Breadcrumbs lang={lang} crumbs={[{ label: t.projects, href: routes.projects[lang] }, { label: project.name, href: projectPath(project.slug, lang) }]} />
        <p class="case-meta">{project.category[lang]} · {project.year}</p>
        <h1 class="case-title">{project.name}</h1>
        <p class="case-summary">{project.summary[lang]}</p>

        <div class="actions">
          {project.demoUrl && <ActionLink href={project.demoUrl} icon="external" external>{t.demo}</ActionLink>}
          {project.codeUrl && <ActionLink href={project.codeUrl} variant="ghost" icon="github" external>{t.code}</ActionLink>}
          {project.mockupUrl && <ActionLink href={project.mockupUrl} variant="figma" icon="figma" external>{t.mockup}</ActionLink>}
        </div>

        <dl class="case-facts">
          <div><dt>{t.client}</dt><dd>{project.client[lang]}</dd></div>
          <div><dt>{t.role}</dt><dd>{project.role[lang]}</dd></div>
          <div><dt>{t.location}</dt><dd>{project.location[lang]}</dd></div>
          <div><dt>{t.year}</dt><dd>{project.year}</dd></div>
        </dl>

        <h2 class="case-label">{t.about}</h2>
        <p class="case-text">{project.description[lang]}</p>

        <h2 class="case-label">{t.built}</h2>
        <ul class="checklist">
          {project.highlights[lang].map(h => <li>{h}</li>)}
        </ul>

        <h2 class="case-label">{t.stack}</h2>
        <ul class="chips">
          {project.stack.map(tech => {
            const icon = skillIcon(tech);
            return <li class="chip">{icon && <img src={icon} alt="" loading="lazy" decoding="async" />}{tech}</li>;
          })}
        </ul>
      </div>
    </div>

    <div class="case-media">
      <img class="case-logo" src={projectImage(project, project.logo)} alt={`${project.name} logo`} loading="eager" decoding="async" />
      {project.fullPage ? (
        <BrowserFrame
          src={projectImage(project, 'full.webp')}
          alt={es ? `Página de inicio completa de ${project.name}` : `${project.name} full home page`}
          url={project.demoUrl}
          width={fullSize.width}
          height={fullSize.height}
          eager
          class="case-full"
        />
      ) : (
        <BrowserFrame src={projectImage(project, 'cover.webp')} alt={shotAlt(1)} url={project.demoUrl} width={1600} height={1000} eager class="case-full" />
      )}

      <h2 class="case-media-title">{t.screens}</h2>
      <div class="case-gallery">
        {project.mobile && (
          <figure class="phone case-phone">
            <img src={projectImage(project, 'mobile.webp')} alt={es ? `${project.name} en celular` : `${project.name} on mobile`} width="780" height="1688" loading="lazy" decoding="async" />
          </figure>
        )}
        {gallery.map((src, i) => (
          <BrowserFrame src={src} alt={shotAlt(i + 2)} width={1600} height={1000} />
        ))}
      </div>
    </div>
  </article>

  <div role="navigation" class="wrap case-nav" aria-label={t.projects}>
    <a href={projectPath(prev.slug, lang)} class="case-nav-link">
      <span>← {t.prev}</span>
      <strong>{prev.name}</strong>
    </a>
    <a href={routes.projects[lang]} class="case-nav-all">{t.back}</a>
    <a href={projectPath(next.slug, lang)} class="case-nav-link case-nav-next">
      <span>{t.next} →</span>
      <strong>{next.name}</strong>
    </a>
  </div>
</PageLayout>

<style is:global>
.case {
  display: grid;
  grid-template-columns: 1fr;
}
@media (min-width: 1024px) {
  .case { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); min-height: 100vh; }
}
.case-info { padding: 8rem 1.25rem 3rem; }
@media (min-width: 1024px) {
  .case-info { padding: 0 3rem 4rem max(2rem, calc((100vw - 1280px) / 2 + 2rem)); }
  .case-info-inner { padding-top: 8.5rem; }
}
.case-info-inner { display: flex; flex-direction: column; gap: 1.25rem; max-width: 34rem; }
.case-meta {
  font-size: 0.8rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-primary-500);
}
.case-title {
  font-size: clamp(2.6rem, 5.5vw, 4.4rem);
  line-height: 0.92;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  text-wrap: balance;
  margin-top: -0.5rem;
}
.case-summary { font-size: 1.2rem; line-height: 1.55; color: rgba(255, 255, 255, 0.85); }
.case-label {
  margin-top: 0.75rem;
  font-size: 0.8rem;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.55);
}
.case-text { line-height: 1.7; color: rgba(255, 255, 255, 0.8); }
.case-facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem 1.5rem;
  padding: 1.25rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}
.case-facts dt {
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 0.2rem;
}
.case-facts dd { font-weight: 700; line-height: 1.4; }

.case-media {
  position: relative;
  padding: 2.5rem 1.25rem 3rem;
  background:
    radial-gradient(90% 50% at 100% 0%, rgba(255, 255, 255, 0.16), transparent 60%),
    linear-gradient(to bottom, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.25)),
    var(--brand);
  overflow: hidden;
}
@media (min-width: 1024px) {
  .case-media { padding: 8.5rem 4rem 5rem; }
}
.case-media::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px);
  background-size: 20px 20px;
  mask-image: linear-gradient(to bottom, black, transparent 40%);
  pointer-events: none;
}
.case-media > * { position: relative; }
.case-logo { display: block; height: 3.5rem; width: auto; max-width: 70%; object-fit: contain; object-position: left; margin: 0 auto 2rem 0; }
.case-full { max-width: 52rem; margin: 0 auto; }
.case-media-title {
  margin: 3.5rem 0 1.5rem;
  font-size: 0.8rem;
  font-weight: 900;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.75);
}
.case-gallery {
  display: grid;
  gap: 1.5rem;
  grid-template-columns: 1fr;
  max-width: 52rem;
  margin: 0 auto;
}
@media (min-width: 640px) {
  .case-gallery { grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr); align-items: start; }
  .case-gallery .case-phone { grid-row: span 2; }
  .case-gallery > .browser:nth-child(n + 4) { grid-column: 1 / -1; }
}
.case-phone { max-width: 16rem; margin: 0 auto; }

.case-nav {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
  align-items: center;
  margin-top: 3rem;
}
@media (min-width: 768px) {
  .case-nav { grid-template-columns: 1fr auto 1fr; }
}
.case-nav-link {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
  padding: 1.25rem 1.5rem;
  border-radius: 1rem;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: var(--color-secondary-800);
  color: white;
  text-decoration: none;
  transition: border-color 160ms ease, transform 160ms ease;
}
.case-nav-link:hover { border-color: rgba(255, 190, 65, 0.5); transform: translateY(-3px); }
.case-nav-link span { font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-primary-500); }
.case-nav-link strong { font-size: 1.3rem; font-weight: 900; font-style: italic; text-transform: uppercase; }
.case-nav-next { text-align: right; }
.case-nav-all {
  justify-self: center;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.7);
  text-decoration: underline;
  text-underline-offset: 0.3em;
}
.case-nav-all:hover { color: var(--color-primary-500); }
</style>
