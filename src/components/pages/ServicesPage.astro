---
import PageLayout from '../../layouts/PageLayout.astro';
import ActionLink from '../ui/ActionLink.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import { servicesPage } from '../../data/pages';
import { getProject } from '../../data/projects';
import { absolute, homeSection, projectPath, routes, ui } from '../../data/site';
import type { Lang } from '../../data/translations';

const { lang } = Astro.props as { lang: Lang };
const c = servicesPage[lang];
const label = ui[lang].nav.services;

const icons: Record<string, string> = {
  web: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M7 6.5h.01M10 6.5h.01"/>',
  cart: '<circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h2.6l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1l1.6-6.3H6.1"/>',
  cms: '<path d="M4 20h4l10.5-10.5a2.1 2.1 0 0 0-3-3L5 17v3z"/><path d="M13.5 6.5l3 3"/>',
  app: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M17.5 14v7M14 17.5h7"/>',
  seo: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20.5 20.5-5.2-5.2M8 11l2 2 3.5-4"/>',
  globe: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>',
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: lang === 'es' ? 'Anderson Rueda - Desarrollo de software y páginas web' : 'Anderson Rueda - Software and web development',
  url: absolute(routes.services[lang]),
  image: absolute('/backgrounds/og-image.png'),
  email: 'contactoandersonrueda@gmail.com',
  founder: { '@id': `${absolute('/')}#person` },
  address: { '@type': 'PostalAddress', addressLocality: 'Barranquilla', addressRegion: 'Atlántico', addressCountry: 'CO' },
  areaServed: [
    { '@type': 'City', name: 'Barranquilla' },
    { '@type': 'Country', name: 'Colombia' },
    { '@type': 'Place', name: lang === 'es' ? 'Remoto, todo el mundo' : 'Remote, worldwide' },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: label,
    itemListElement: c.services.map(s => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.title, description: s.text },
    })),
  },
};
---

<PageLayout
  lang={lang}
  title={c.title}
  description={c.description}
  paths={{ es: routes.services.es, en: routes.services.en }}
  crumbs={[{ label, href: routes.services[lang] }]}
>
  <script type="application/ld+json" slot="schema" set:html={JSON.stringify(serviceSchema)} />

  <header class="wrap page-hero">
    <Breadcrumbs lang={lang} crumbs={[{ label, href: routes.services[lang] }]} />
    <h1 class="display">{c.h1}</h1>
    <p class="lead">{c.lead}</p>
    <div class="actions services-actions">
      <ActionLink href={homeSection('contact', lang)} icon="mail">{ui[lang].cta.contact}</ActionLink>
      <ActionLink href={routes.projects[lang]} variant="ghost" icon="arrow">{ui[lang].nav.projects}</ActionLink>
    </div>
  </header>

  <section class="wrap page-section">
    <div class="tiles services-tiles">
      {c.services.map(s => (
        <article class="tile">
          <div class="tile-icon"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} /></div>
          <h2 class="services-tile-title">{s.title}</h2>
          <p>{s.text}</p>
          <p class="services-related">
            <span>{c.projectsLabel}:</span>
            {s.projects.map((slug, i) => {
              const p = getProject(slug)!;
              return <>{i > 0 && ', '}<a href={projectPath(slug, lang)}>{p.name}</a></>;
            })}
          </p>
        </article>
      ))}
    </div>
  </section>

  <section class="wrap page-section">
    <h2 class="section-title">{c.hireTitle}</h2>
    <p class="lead services-sub">{c.hireText}</p>
    <div class="tiles">
      {c.hire.map(h => <div class="tile"><h3>{h.title}</h3><p>{h.text}</p></div>)}
    </div>
  </section>

  <section class="wrap page-section">
    <h2 class="section-title">{c.processTitle}</h2>
    <ol class="steps services-steps">
      {c.process.map(p => <li><h3>{p.title}</h3><p>{p.text}</p></li>)}
    </ol>
  </section>
</PageLayout>

<style is:global>
.services-actions { margin-top: 2rem; }
.services-tile-title {
  font-size: 1.2rem;
  font-weight: 900;
  font-style: italic;
  text-transform: uppercase;
  margin-bottom: 0.5rem;
}
.services-related { margin-top: 1rem; font-size: 0.88rem; }
.services-related span { color: rgba(255, 255, 255, 0.5); margin-right: 0.3rem; }
.services-related a { color: var(--color-primary-500); text-decoration: none; font-weight: 700; }
.services-related a:hover { text-decoration: underline; }
.services-sub { margin: 1rem 0 1.75rem; }
.services-steps { margin-top: 1.75rem; }
</style>
