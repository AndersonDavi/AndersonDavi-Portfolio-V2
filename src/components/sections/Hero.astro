---
---

<section id="title">
  <div class="size-full floatingY content-container px-4 relative">
    <h1 class="header-title">
      <span class="text-primary-500" style="font-family: var(--font-mars) !important;">ANDERSON</span>
      <br />
      <span style="font-family: var(--font-mars) !important;">RUEDA</span>
      <span class="sr-only">| Desarrollador Angular & Full Stack | Web Developer</span>
    </h1>
    <div class="text-decoration-1">
      <span class="scale" style="font-family: var(--font-mars) !important;">Web developer</span>
      <a href="#about">
        <img src="/icons/scroll-down.svg" alt="scroll down" class="scale" />
      </a>
    </div>
    <span class="text-decoration-2 scale" style="font-family: var(--font-mars) !important;">404</span>
  </div>
</section>

<style is:global>
#title {
  background-image: url("/backgrounds/bg2.webp");
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  width: 100vw;
  height: calc(100vh + 5vh);
  aspect-ratio: 16/9;
  position: relative;
  content-visibility: auto;
  contain: paint;
}
#title div * {
  font-family: var(--font-mars) !important;
}
.content-container {
  opacity: 0.9;
  mix-blend-mode: screen;
  filter: saturate(2);
}
.header-title {
  font-size: clamp(4rem, 18vw, 20rem);
  text-align: center;
  line-height: 0.75em;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  margin-bottom: 2.5rem;
  animation: titleAppear 0.75s both;
  animation-delay: 0.5s;
  will-change: transform, opacity;
  transition: filter 150ms ease, transform 150ms ease;
  cursor: pointer;
}
.header-title:hover {
  filter: brightness(1.15);
}
.header-title:active {
  transform: translate(-50%, -50%) scale(0.96);
}
@keyframes titleAppear {
  0% { opacity: 0; }
  100% { opacity: 1; }
}
.text-decoration-1 {
  font-size: clamp(2rem, 5vw, 25rem);
  text-align: center;
  line-height: 0.75em;
  position: absolute;
  bottom: calc(6vh);
  left: 50%;
  transform: translateX(-50%);
  color: var(--color-primary-500);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  animation: titleAppear 1s both;
  animation-delay: 0.5s;
}
.text-decoration-1 span {
  font-size: clamp(2rem, 4vw, 25rem);
  color: var(--color-primary-500);
  animation: titleAppear 1s both;
  animation-delay: 0.5s;
}
.text-decoration-1 img {
  width: 2rem;
  height: 2rem;
  cursor: pointer;
  margin: 0 auto;
  animation: titleAppear 1s both;
  animation-delay: 0.5s;
}
.text-decoration-2 {
  font-size: clamp(2rem, 3vw, 25rem);
  text-align: center;
  line-height: 0.75em;
  position: absolute;
  top: calc(50% - 80px);
  left: calc(10vw);
  transform: rotate(-12deg);
  animation: titleAppear 1s both;
  animation-delay: 0.6s;
}
@media (min-width: 640px) {
  .text-decoration-2 { top: calc(50% - 110px); }
}
@media (min-width: 1024px) {
  .text-decoration-2 { top: calc(50% - 130px); }
  .text-decoration-1 img { width: 2.5rem; height: 2.5rem; }
}
</style>
