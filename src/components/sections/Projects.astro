---
import ProjectCard from '../ProjectCard.astro';
import ActionLink from '../ui/ActionLink.astro';
import { projects } from '../../data/projects';
import { routes } from '../../data/site';
import { translations, type Lang } from '../../data/translations';
import { buildHoverHtml } from '../../scripts/i18n';

const { lang = 'es' } = Astro.props as { lang?: Lang };
const t = translations[lang];
const titleHtml = buildHoverHtml(t.projectsTitle, '7xl', false);
const copy = lang === 'es'
  ? { lead: 'Sitios web, catálogos y aplicaciones que he diseñado y desarrollado para empresas en Colombia y Estados Unidos.', all: 'Ver todos los proyectos' }
  : { lead: 'Websites, catalogs and applications I designed and built for companies in Colombia and the United States.', all: 'See all projects' };
---

<section id="projects" class="scroll-mt-[90px]">
  <div class="wrap">
    <div class="projects-head">
      <h2
        class="text-5xl sm:text-6xl font-black uppercase relative hover-string-container"
        data-hover-key="projectsTitle"
        data-grow-size="7xl"
        set:html={titleHtml}
      />
      <p class="lead">{copy.lead}</p>
    </div>
    <div class="pgrid">
      {projects.map((project, i) => <ProjectCard project={project} lang={lang} featured={i === 0} />)}
    </div>
    <div class="projects-more">
      <ActionLink href={routes.projects[lang]} variant="ghost" icon="arrow">{copy.all}</ActionLink>
    </div>
  </div>
</section>

<style is:global>
#projects { padding: 6rem 0 4rem; }
.projects-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.25rem;
  margin-bottom: 3rem;
  text-align: center;
}
.projects-more { display: flex; justify-content: center; margin-top: 3rem; }
</style>
