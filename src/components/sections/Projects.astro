---
import { translations } from '../../data/translations';
import { buildHoverHtml } from '../../scripts/i18n';
const { lang = 'es' } = Astro.props;
const t = translations[lang as keyof typeof translations];
const projects = t.projects.items;
const titleHtml = buildHoverHtml(t.projectsTitle, '7xl', false);
---

<section id="projects" class="scroll-mt-[90px]">
  <div class="projects-title opacity-appearR">
    <div
      class="text-5xl sm:text-6xl font-black uppercase relative hover-string-container"
      data-hover-key="projectsTitle"
      data-grow-size="7xl"
      set:html={titleHtml}
    />
  </div>

  <div class="projects-container">
    <!-- Project selector tabs -->
    <div class="project-selector-container">
      <ul class="project-selector opacity-appearL mx-auto">
        {projects.map((project, idx) => (
          <li
            class={`project-tab${idx === 0 ? ' active-tab' : ''}`}
            data-project-id={project.id}
          >
            <img
              src={`/logos/${project.logo_img}`}
              alt={`${project.title.replace(/#/g, '')} logo`}
            />
          </li>
        ))}
      </ul>
    </div>

    <!-- Project details — all rendered, only one visible -->
    {projects.map((project, idx) => (
      <div
        class={`project-detail${idx === 0 ? ' active-project' : ' hidden-project'}`}
        data-project-id={project.id}
      >
        <div class="project-info relative">
          <!-- Images column -->
          <div class="project-info-images relative">
            <div class="project-gallery-hero">
              <div
                class="project-gallery-shape"
                style={`background-color: ${project.colors[0]};`}
              ></div>

              <img
                src={`/logos/${project.logo_img_noColor || project.logo_img}`}
                alt={`${project.title.replace(/#/g, '')} logo`}
                class="project-gallery-logo scale"
              />

              <div class="project-gallery-featured">
                <img
                  src={`/gal-img/${project.x_images[0]}`}
                  alt={`${project.title.replace(/#/g, '')} screenshot`}
                  class="project-gallery-main scale-down"
                />
                <div class="project-gallery-side">
                  <img src={`/gal-img/${project.x_images[1]}`} alt="" class="scale-down" />
                  <img src={`/gal-img/${project.x_images[2]}`} alt="" class="scale-down" />
                </div>
              </div>
            </div>

            <div class="project-gallery-colors">
              <ul class="colors">
                {project.colors.map(color => (
                  <li style={`background-color: ${color}; --hover-color: ${color}`}></li>
                ))}
              </ul>
            </div>

            <div class="project-gallery-grid">
              {project.x_images.slice(3).map((image, imageIdx) => (
                <img
                  src={`/gal-img/${image}`}
                  alt={`${project.title.replace(/#/g, '')} screenshot ${imageIdx + 4}`}
                  class="scale-down"
                />
              ))}
            </div>

            <div class="project-gallery-device">
              <div
                class="project-gallery-device-bg"
                style={`background-color: ${project.colors[0]}`}
              ></div>
              <img
                src={`/gal-img/${project.x_images[0]}`}
                alt={`${project.title.replace(/#/g, '')} desktop`}
                class="project-gallery-desktop scale"
              />
              <img
                src={`/gal-img/${project.y_images[0]}`}
                alt={`${project.title.replace(/#/g, '')} mobile`}
                class="project-gallery-mobile scale draggable"
              />
            </div>
          </div>

          <!-- Text column -->
          <div class="project-info-text">
            <div class="projects-title-card">
              <span
                class="text-5xl sm:text-6xl font-black italic hover-string-container"
                data-hover-key={`projects.items.${idx}.title`}
                data-grow-size="6xl"
                set:html={buildHoverHtml(project.title, '6xl', false)}
              />
            </div>
            <p data-i18n={`projects.items.${idx}.description`}>{project.description}</p>
            <ul class="project-info-technologies">
              {project.technologies.map(tech => (
                <li>
                  <img src={`/skills/${tech.img}`} alt={`${tech.title} icon`} />
                  <span>{tech.title}</span>
                </li>
              ))}
            </ul>
            <div class="project-info-btns">
              {project.demo_url && (
                <a href={project.demo_url} target="_blank" rel="noopener noreferrer" class="btn btn-demo">DEMO</a>
              )}
              {'code_url' in project && project.code_url && (
                <a href={(project as any).code_url} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                  <img src="/skills/github.svg" alt="github icon" />CÓDIGO
                </a>
              )}
              {'mockup_url' in project && project.mockup_url && (
                <a href={(project as any).mockup_url} target="_blank" rel="noopener noreferrer" class="btn btn-figma">
                  <div>
                    <img src="/skills/figma.webp" alt="figma icon" /><span>MOCKUP</span>
                  </div>
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<style is:global>
#projects {
  background-color: var(--color-secondary-500);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  margin-top: 7rem;
  scroll-margin-top: 90px;
}
@media (min-width: 768px) { #projects { margin-top: 9rem; } }
@media (min-width: 1280px) { #projects { margin-top: 10rem; } }
.projects-title {
  text-align: center;
  font-style: italic;
}
.hover-string-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  column-gap: 0.18em;
  row-gap: 0.05em;
}
.projects-container {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
  padding: 5rem 0;
  width: 100vw;
  justify-content: center;
  min-height: 100vh;
  position: relative;
  isolation: isolate;
}
.project-selector-container {
  position: relative;
  z-index: 5;
  background-color: var(--color-secondary-500);
  padding: 0.5rem 0;
}
.project-selector {
  display: flex;
  gap: 0.5rem;
  overflow: auto;
  align-items: flex-start;
  justify-content: flex-start;
  width: 100%;
  padding: 1.25rem 2.5rem;
  list-style: none;
}
.project-selector::-webkit-scrollbar { height: 0.5rem; }
.project-selector::-webkit-scrollbar-thumb { background-color: rgba(255, 190, 65, 0.25); border-radius: 9999px; }
.project-selector::-webkit-scrollbar-track { background: transparent; }
.project-tab {
  border: 1px solid rgba(255, 202, 65, 0.25);
  border-radius: 0.375rem;
  height: 7rem;
  aspect-ratio: 1;
  backdrop-filter: blur(1rem);
  cursor: pointer;
  transition: all 75ms ease;
  min-width: 10rem;
  max-width: 300px;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(27, 24, 24, 0.75);
}
.project-tab:hover { border-color: rgba(255, 202, 65, 0.4); background-color: rgba(204, 151, 52, 0.05); }
.project-tab:active { border: 2px solid rgba(255, 190, 65, 0.75); box-shadow: 0 1px 2px rgba(255, 190, 65, 0.05); }
.project-tab.active-tab { border: 2px solid rgba(255, 202, 65, 0.8); background-color: rgba(204, 151, 52, 0.15); }
.project-tab img { width: 100%; height: 100%; object-fit: contain; }
.project-tab img:hover { transform: scale(1.05); }
.project-tab img:active { transform: scale(0.95); }
.hidden-project { display: none; }
.active-project { display: block; width: 100%; }
.project-detail { width: 100%; position: relative; z-index: 1; }
.project-info {
  border-radius: 0.375rem;
  display: flex;
  flex-direction: column;
  width: 100%;
  hyphens: auto;
  align-items: flex-start;
}
@media (min-width: 1024px) {
  .project-info { flex-direction: row-reverse; height: auto; }
}
.project-info-images {
  width: 100%;
  margin-bottom: 0.75rem;
  display: flex;
  flex-direction: column;
  overflow-x: hidden;
  overflow-y: visible;
  z-index: 1;
}
@media (min-width: 1024px) {
  .project-info-images { width: 50%; margin-bottom: 0; }
}
.project-gallery-hero {
  min-height: 430px;
  position: relative;
  overflow: hidden;
  width: 100%;
  padding: 2rem 0 0 1.5rem;
}
.project-gallery-shape {
  position: absolute;
  top: 0;
  left: -5rem;
  z-index: 0;
  width: min(88vw, 620px);
  height: 72%;
  transform: skewX(-28deg);
  transform-origin: top left;
  overflow: hidden;
}
.project-gallery-shape::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent 18%);
}
.project-gallery-logo {
  position: relative;
  z-index: 2;
  display: block;
  width: min(72%, 360px);
  height: 7rem;
  object-fit: contain;
  object-position: left center;
  margin-bottom: 2rem;
}
.project-gallery-featured {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  width: calc(100% + 4.5rem);
}
.project-gallery-main {
  width: 72%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 18px 30px rgba(0, 0, 0, 0.28);
}
.project-gallery-side {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  width: 34%;
  margin-right: -5rem;
}
.project-gallery-side img {
  width: 100%;
  aspect-ratio: 16 / 9;
  object-fit: cover;
  border-radius: 1rem;
  box-shadow: 0 14px 24px rgba(0, 0, 0, 0.24);
}
.project-gallery-colors {
  display: flex;
  justify-content: flex-end;
  padding: 0 2rem;
  margin: 1rem 0 0.75rem;
}
.project-gallery-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.5rem;
  width: calc(100% + 7rem);
  margin-left: -3.5rem;
  overflow: visible;
}
.project-gallery-grid img {
  width: 100%;
  height: 22rem;
  object-fit: cover;
  object-position: top center;
}
.project-gallery-device {
  position: relative;
  min-height: 520px;
  margin-top: 4rem;
  overflow: hidden;
}
.project-gallery-device-bg {
  position: absolute;
  left: -3rem;
  right: -3rem;
  bottom: 0;
  z-index: 0;
  height: 42%;
  box-shadow: inset 0 -34px 36px rgba(0, 0, 0, 0.34);
}
.project-gallery-desktop {
  position: absolute;
  z-index: 1;
  left: 7%;
  bottom: 6.5rem;
  width: min(76%, 660px);
  aspect-ratio: 16 / 10;
  object-fit: cover;
  object-position: top center;
  border: 14px solid #111827;
  border-bottom-width: 22px;
  border-radius: 1.25rem;
  box-shadow: 0 18px 30px rgba(0, 0, 0, 0.42);
  transform: rotate(-3deg);
}
.project-gallery-mobile {
  position: absolute;
  z-index: 2;
  right: 12%;
  bottom: 2.75rem;
  width: min(28%, 190px);
  aspect-ratio: 9 / 16;
  object-fit: cover;
  object-position: top center;
  border: 13px solid #111827;
  border-bottom-width: 20px;
  border-radius: 2rem;
  box-shadow: 0 18px 30px rgba(0, 0, 0, 0.48);
  transform: rotate(8deg);
}
@media (min-width: 768px) {
  .project-gallery-hero {
    min-height: 560px;
    padding-left: 3rem;
  }
  .project-gallery-shape {
    left: -6rem;
    width: min(74vw, 720px);
    height: 78%;
  }
  .project-gallery-logo {
    height: 9rem;
    margin-bottom: 2.75rem;
  }
}
@media (max-width: 767px) {
  .project-gallery-featured {
    width: calc(100% + 2rem);
  }
  .project-gallery-main {
    width: 76%;
  }
  .project-gallery-side {
    width: 40%;
    margin-right: -3rem;
  }
  .project-gallery-grid {
    grid-template-columns: repeat(2, minmax(16rem, 1fr));
    width: calc(100% + 5rem);
    margin-left: -2.5rem;
  }
  .project-gallery-grid img {
    height: 16rem;
  }
  .project-gallery-device {
    min-height: 420px;
    margin-top: 2.5rem;
  }
  .project-gallery-desktop {
    left: 1rem;
    width: 82%;
    bottom: 6rem;
  }
  .project-gallery-mobile {
    right: 1.5rem;
    width: 33%;
    bottom: 2.5rem;
  }
}
.project-info-text {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding-left: 2.5rem;
  padding-right: 1.25rem;
  padding-top: 2rem;
  position: relative;
  z-index: 2;
}
@media (min-width: 1024px) {
  .project-info-text {
    width: 50%;
    padding-top: 0;
    position: sticky;
    top: 6rem;
    align-self: flex-start;
  }
}
.projects-title-card { margin-bottom: 0.5rem; text-align: left; }
.projects-title-card .hover-string-container { justify-content: flex-start; }
.project-info p { font-size: 1.25rem; }
.project-gallery-mobile:active { cursor: grabbing; }
.colors {
  display: flex;
  transition: transform 75ms ease;
  list-style: none;
  padding: 0;
}
.colors li {
  width: 3.5rem;
  height: 3.5rem;
  border: 1px solid rgba(0,0,0,0.5);
  transition: all 300ms ease;
  cursor: pointer;
}
.colors li:hover { transform: scale(0.95) translateY(4px); border: 1px solid var(--hover-color); box-shadow: 0 0 10px var(--hover-color); }
.colors li:active { transform: scale(0.9); border: 2px solid var(--hover-color); box-shadow: 0 0 20px var(--hover-color); }
.project-info-technologies {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: auto;
  gap: 0.5rem;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 0.5rem;
  list-style: none;
  padding: 0;
  hyphens: none;
}
.project-info-technologies li {
  padding: 0.5rem;
  object-fit: contain;
  height: 2rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  border: 1px solid rgba(255, 202, 65, 0.5);
  width: auto;
  cursor: pointer;
  transition: all 75ms ease;
}
.project-info-technologies li:hover { border: 2px solid rgba(255, 202, 65, 0.75); }
.project-info-technologies li img { width: 100%; height: 100%; object-fit: contain; }
.project-info-btns {
  display: flex;
  flex-direction: row;
  width: 100%;
  height: auto;
  gap: 0.5rem;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 0.5rem;
}
.btn-demo { border: 2px solid var(--color-primary-300); color: var(--color-primary-500); background-color: transparent; text-decoration: none; }
.btn-demo:hover { border-color: var(--color-primary-500); color: var(--color-primary-300); }
.btn-secondary { border: 2px solid white; color: white; display: flex; padding: 0 0.25rem; align-items: center; gap: 0.5rem; text-decoration: none; }
.btn-secondary::before, .btn-secondary::after { background-color: white; }
.btn-secondary:hover { color: black; }
.btn-secondary img { width: 1.25rem; height: 1.25rem; background-color: black; border-radius: 9999px; }
.btn-figma { color: white; display: flex; align-items: center; padding: 2px; width: fit-content; background: linear-gradient(90deg, #f24e1e, #a259ff, #0acf83); background-size: 150% 100%; text-decoration: none; }
.btn-figma:hover { background-position: 100% 0; }
.btn-figma div { background-color: #2c2c2c; display: flex; align-items: center; width: 100%; border-radius: 2px; gap: 0.25rem; transition: background-color 0.3s ease; }
.btn-figma:hover div { background-color: transparent; }
.btn-figma img { width: 1.5rem; height: 1.5rem; transition: transform 0.3s ease; }
.btn-figma:hover img { transform: scale(1.1); }
.draggable { cursor: grab; }
.draggable:active { cursor: grabbing; }
@keyframes projectAppearR {
  from { transform: scale(0) rotate(-45deg); }
  to { transform: scale(1) rotate(6deg); }
}
</style>

<script>
  import { applyLang, buildHoverHtml, getCurrentLang } from '../../scripts/i18n';
  import { translations } from '../../data/translations';

  // Tab switching
  const tabs = document.querySelectorAll<HTMLElement>('.project-tab');
  const details = document.querySelectorAll<HTMLElement>('.project-detail');

  function switchProject(id: number) {
    tabs.forEach(tab => {
      tab.classList.toggle('active-tab', parseInt(tab.dataset.projectId!) === id);
    });
    details.forEach(detail => {
      const isActive = parseInt(detail.dataset.projectId!) === id;
      detail.classList.toggle('hidden-project', !isActive);
      detail.classList.toggle('active-project', isActive);
      if (isActive) {
        const img = detail.querySelector('.img-min-2') as HTMLElement;
        if (img) {
          img.style.animation = 'none';
          void img.offsetHeight;
          img.style.animation = '';
        }
      }
    });
    resetDraggables();
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      switchProject(parseInt(tab.dataset.projectId!));
    });
  });

  // Draggable images
  let dragEl: HTMLElement | null = null;
  let offsetX = 0, offsetY = 0;

  document.addEventListener('mousedown', (e: MouseEvent) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('draggable')) {
      dragEl = target;
      offsetX = e.clientX - target.offsetLeft;
      offsetY = e.clientY - target.offsetTop;
      target.style.position = 'absolute';
      target.style.cursor = 'grabbing';
    }
  });
  document.addEventListener('mousemove', (e: MouseEvent) => {
    if (dragEl) {
      e.preventDefault();
      dragEl.style.left = (e.clientX - offsetX) + 'px';
      dragEl.style.top = (e.clientY - offsetY) + 'px';
      dragEl.style.transform = 'none';
    }
  });
  document.addEventListener('mouseup', () => {
    if (dragEl) { dragEl.style.cursor = 'grab'; dragEl = null; }
  });

  function resetDraggables() {
    document.querySelectorAll<HTMLElement>('.draggable').forEach(el => {
      el.style.position = '';
      el.style.left = '';
      el.style.top = '';
      el.style.transform = '';
    });
  }

  // Language change — rebuild HoverStrings in projects
  document.addEventListener('languageChange', (e: Event) => {
    const { lang } = (e as CustomEvent).detail;
    const t = translations[lang as 'es' | 'en'];

    // Rebuild project title hover strings
    document.querySelectorAll<HTMLElement>('[data-hover-key^="projects.items"]').forEach(el => {
      const key = el.dataset.hoverKey!;
      const parts = key.split('.');
      const idx = parseInt(parts[2]);
      const value = t.projects.items[idx]?.title;
      if (value) {
        el.innerHTML = buildHoverHtml(value, el.dataset.growSize || '6xl', false);
      }
    });

    // Update project descriptions
    t.projects.items.forEach((project, idx) => {
      const descEl = document.querySelector(`[data-i18n="projects.items.${idx}.description"]`);
      if (descEl) descEl.textContent = project.description;
    });

    // Rebuild the main portfolio title
    const titleEl = document.querySelector('[data-hover-key="projectsTitle"]');
    if (titleEl) {
      (titleEl as HTMLElement).innerHTML = buildHoverHtml(t.projectsTitle, '7xl', false);
    }
  });

  // Init language
  const lang = getCurrentLang();
  if (lang !== 'es') {
    applyLang(lang);
    // Trigger rebuild for hover strings
    document.dispatchEvent(new CustomEvent('languageChange', { detail: { lang } }));
  }
</script>
