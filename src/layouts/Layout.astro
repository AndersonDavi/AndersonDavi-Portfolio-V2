---
import '../styles/global.css';
import '../styles/buttons.css';
import { alternateUrls, baseUrl, getSeo } from '../data/seo';
import type { Lang } from '../data/translations';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  keywords?: string;
  lang?: Lang;
  noindex?: boolean;
}

const { lang = 'es', noindex = false } = Astro.props;
const seo = getSeo(lang);
const title = Astro.props.title ?? seo.title;
const description = Astro.props.description ?? seo.description;
const canonical = Astro.props.canonical ?? seo.canonical;
const keywords = Astro.props.keywords ?? seo.keywords;
const ogImage = `${baseUrl}/backgrounds/og-image.png`;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Anderson Rueda',
  alternateName: 'Anderson David Rueda Consuegra',
  url: `${baseUrl}/`,
  image: ogImage,
  jobTitle: seo.personJobTitle,
  description: seo.personDescription,
  email: 'contactoandersonrueda@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barranquilla',
    addressRegion: 'Atlantico',
    addressCountry: 'CO',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Activos S.A.S',
  },
  knowsAbout: [
    'Angular',
    'Astro',
    'TypeScript',
    'JavaScript',
    'Java',
    'Node.js',
    'NestJS',
    'SQL Server',
    'PostgreSQL',
    'MySQL',
    'Firestore',
    'Docker',
    'AWS',
    'Google Cloud Platform',
    'Power Platform',
    'Tailwind CSS',
    'Bootstrap',
    'Software Development',
    'Web Development',
  ],
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'SENA',
    description: seo.alumniDescription,
  },
  sameAs: [
    'https://www.linkedin.com/in/anderson-david-rueda-consuegra-16b32821b/',
    'https://github.com/AndersonDavi',
  ],
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: seo.websiteName,
  url: `${baseUrl}/`,
  description: seo.websiteDescription,
  inLanguage: seo.lang,
  author: { '@type': 'Person', name: 'Anderson Rueda' },
};
---
<!doctype html>
<html lang={seo.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Anderson Rueda" />

    <!-- Robots -->
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1'} />
    <meta name="language" content={seo.languageMeta} />
    <meta name="revisit-after" content="7 days" />
    <meta name="rating" content="general" />

    <!-- Geo / Local SEO - Barranquilla, Colombia -->
    <meta name="geo.region" content="CO-ATL" />
    <meta name="geo.placename" content="Barranquilla, Colombia" />
    <meta name="geo.position" content="10.9685;-74.7813" />
    <meta name="ICBM" content="10.9685, -74.7813" />

    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="ahZS4qCnXiX1NPEs2xwk0r2orlPFeorWpFTa6KkBEok" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content={seo.ogLocale} />
    <meta property="og:locale:alternate" content={seo.alternateLocale} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Canonical and language alternates -->
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="es" href={alternateUrls.es} />
        <link rel="alternate" hreflang="en" href={alternateUrls.en} />
        <link rel="alternate" hreflang="x-default" href={alternateUrls.default} />
      </>
    )}

    <!-- PWA -->
    <meta name="theme-color" content="#ffbe41" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700;900&display=swap" rel="stylesheet" />

    <!-- Preload critical assets -->
    <link rel="preload" href="/fonts/MARSNEVENEKSK-Regular.otf" as="font" type="font/otf" crossorigin />
    <link rel="preload" href="/simbolo.svg" as="image" fetchpriority="high" />
    <link rel="preload" href="/backgrounds/bg2.webp" as="image" fetchpriority="high" />

    <!-- JSON-LD: Person -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

    <!-- Page-specific schema slot -->
    <slot name="schema" />
  </head>
  <body>
    <slot />
  </body>
</html>
